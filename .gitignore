__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
/.venv/
venv/
env/
ENV/
.Python

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ----------------------------
# Secrets & credentials
# ----------------------------
# dotenv files
.env
.env.*

# Service account keys and other secret JSONs (project-specific secrets/ dir allowed)
**/secrets/*.json
*-sa.json
*-key.json
*-credentials.json
*-creds.json
*.pem

# ----------------------------
# Airflow
# ----------------------------
airflow.cfg
airflow.db
logs/  # airflow logs

# ignore airflow temporary folders and __pycache__ inside dags/plugins
dags/__pycache__/
plugins/__pycache__/

# ----------------------------
# Spark / Big Data outputs
# ----------------------------
# Local spark warehouse, parquet/avro outputs
spark-warehouse/
*.parquet
*.avro

# JARs and binary artifacts
*.jar

